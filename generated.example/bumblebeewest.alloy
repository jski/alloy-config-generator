// =========================================
// Grafana Alloy Configuration
// =========================================
// Host: bumblebeewest
// Description: Kubernetes cluster running Alloy
// Deployment: kubernetes
// 
// IMPORTANT: Do not edit manually. Regenerate with:
//   ./generate.py bumblebeewest
// =========================================


// 
// ========== SCRAPE: alloy-self ==========
// Type: metrics
// Description: Alloy self-scrape for health and debugging

//


prometheus.scrape "alloy_self" {
  targets = [
    {"__address__" = "127.0.0.1:12345"},
  ]
  forward_to = [prometheus.relabel.alloy_self.receiver]
  scrape_interval = "30s"

  clustering {
    enabled = false
  }
}


prometheus.relabel "alloy_self" {
  forward_to = [
    prometheus.remote_write.optimus_grafana.receiver,
    prometheus.remote_write.bumblebee_grafana.receiver,
  ]


  // Default labels
  rule {
    target_label = "job"
    replacement  = "alloy"
  }
  rule {
    target_label = "env"
    replacement  = "oracle"
  }
  rule {
    target_label = "site"
    replacement  = "remote"
  }
  rule {
    target_label = "platform"
    replacement  = "kubernetes"
  }
  rule {
    target_label = "cluster"
    replacement  = "bumblebeewest"
  }
}



// 
// ========== SCRAPE: k8s-pod-logs-kubernetes ==========
// Type: logs-k8s
// Description: Pod-level logs via Kubernetes discovery

//

discovery.kubernetes "k8s_pod_logs_kubernetes" {
  role = "pod"
}

loki.source.kubernetes "k8s_pod_logs_kubernetes" {
  targets    = discovery.kubernetes.k8s_pod_logs_kubernetes.targets
  forward_to = [loki.process.k8s_pod_logs_kubernetes.receiver]
}

loki.process "k8s_pod_logs_kubernetes" {
  forward_to = [
    loki.write.optimus_grafana.receiver,
    loki.write.bumblebee_grafana.receiver,
  ]

  stage.static_labels {
    values = {
      job = "kubernetes-pod-logs",
      env = "oracle",
      site = "remote",
      platform = "kubernetes",
      cluster = "bumblebeewest",
    }
  }
}



// 
// ========== SCRAPE: k8s-pod-metrics-kubernetes ==========
// Type: metrics-k8s-pods
// Description: Pod-level metrics via Kubernetes discovery

//

discovery.kubernetes "k8s_pod_metrics_kubernetes" {
  role = "pod"
}

prometheus.scrape "k8s_pod_metrics_kubernetes" {
  targets    = discovery.kubernetes.k8s_pod_metrics_kubernetes.targets
  forward_to = [prometheus.relabel.k8s_pod_metrics_kubernetes.receiver]
  scrape_interval = "30s"

  metrics_path = "/metrics"


  clustering {
    enabled = true
  }
}

prometheus.relabel "k8s_pod_metrics_kubernetes" {
  forward_to = [
    prometheus.remote_write.optimus_grafana.receiver,
    prometheus.remote_write.bumblebee_grafana.receiver,
  ]


  // Default labels
  rule {
    target_label = "job"
    replacement  = "kubernetes-pod-metrics"
  }
  rule {
    target_label = "env"
    replacement  = "oracle"
  }
  rule {
    target_label = "site"
    replacement  = "remote"
  }
  rule {
    target_label = "platform"
    replacement  = "kubernetes"
  }
  rule {
    target_label = "cluster"
    replacement  = "bumblebeewest"
  }
}



// 
// ========== SCRAPE: k8s-node-metrics-filtered ==========
// Type: metrics-k8s
// Description: Kubernetes node metrics with relabel rules

//

discovery.kubernetes "k8s_node_metrics_filtered" {
  role = "node"
}

prometheus.scrape "k8s_node_metrics_filtered" {
  targets    = discovery.kubernetes.k8s_node_metrics_filtered.targets
  forward_to = [prometheus.relabel.k8s_node_metrics_filtered.receiver]
  scrape_interval = "30s"


  clustering {
    enabled = true
  }
}

prometheus.relabel "k8s_node_metrics_filtered" {
  forward_to = [
    prometheus.remote_write.optimus_grafana.receiver,
    prometheus.remote_write.bumblebee_grafana.receiver,
  ]


  // Custom relabel rules
  rule {
    source_labels = ["__meta_kubernetes_node_name"]
    action = "keep"
    regex = "node-.*"
  }
  rule {
    action = "labeldrop"
    regex = "__meta_kubernetes_node_.*"
  }
  rule {
    source_labels = ["__meta_kubernetes_node_name"]
    action = "replace"
    target_label = "instance"
  }
  rule {
    source_labels = ["__name__"]
    action = "keep"
    regex = "(node_cpu_seconds_total|node_memory_MemAvailable_bytes|node_disk_io_time_seconds_total)"
  }


  // Default labels
  rule {
    target_label = "job"
    replacement  = "kubernetes-nodes"
  }
  rule {
    target_label = "env"
    replacement  = "oracle"
  }
  rule {
    target_label = "site"
    replacement  = "remote"
  }
  rule {
    target_label = "platform"
    replacement  = "kubernetes"
  }
  rule {
    target_label = "cluster"
    replacement  = "bumblebeewest"
  }
}



// 
// ========== SCRAPE: k8s-node-exporter-custom ==========
// Type: metrics
// Description: Node exporter service in a custom namespace

//


prometheus.scrape "k8s_node_exporter_custom" {
  targets = [
    {"__address__" = "node-exporter.monitoring.svc.cluster.local:9100"},
  ]
  forward_to = [prometheus.relabel.k8s_node_exporter_custom.receiver]
  scrape_interval = "30s"

  clustering {
    enabled = false
  }
}


prometheus.relabel "k8s_node_exporter_custom" {
  forward_to = [
    prometheus.remote_write.optimus_grafana.receiver,
    prometheus.remote_write.bumblebee_grafana.receiver,
  ]


  // Default labels
  rule {
    target_label = "job"
    replacement  = "node-exporter"
  }
  rule {
    target_label = "env"
    replacement  = "oracle"
  }
  rule {
    target_label = "site"
    replacement  = "remote"
  }
  rule {
    target_label = "platform"
    replacement  = "kubernetes"
  }
  rule {
    target_label = "cluster"
    replacement  = "bumblebeewest"
  }
}



// 
// ========== SCRAPE: traefik-metrics-k8s ==========
// Type: metrics
// Description: Traefik metrics within Kubernetes cluster

//


prometheus.scrape "traefik_metrics_k8s" {
  targets = [
    {"__address__" = "traefik.traefik.svc.cluster.local:9100"},
  ]
  forward_to = [prometheus.relabel.traefik_metrics_k8s.receiver]
  scrape_interval = "10s"

  clustering {
    enabled = false
  }
}


prometheus.relabel "traefik_metrics_k8s" {
  forward_to = [
    prometheus.remote_write.optimus_grafana.receiver,
    prometheus.remote_write.bumblebee_grafana.receiver,
  ]


  // Default labels
  rule {
    target_label = "job"
    replacement  = "traefik"
  }
  rule {
    target_label = "env"
    replacement  = "oracle"
  }
  rule {
    target_label = "site"
    replacement  = "remote"
  }
  rule {
    target_label = "platform"
    replacement  = "kubernetes"
  }
  rule {
    target_label = "cluster"
    replacement  = "bumblebeewest"
  }
}




// ========== RECEIVERS ==========


// Loki endpoint: optimus-grafana
loki.write "optimus_grafana" {
  endpoint {
    url = "https://optimus.example.ts.net:3100/loki/api/v1/push"
  }
}


// Loki endpoint: bumblebee-grafana
loki.write "bumblebee_grafana" {
  endpoint {
    url = "https://bumblebee.example.ts.net:3100/loki/api/v1/push"
  }
}



// Prometheus endpoint: optimus-grafana
prometheus.remote_write "optimus_grafana" {
  endpoint {
    url = "https://optimus.example.ts.net:9090/api/v1/write"
  }
}


// Prometheus endpoint: bumblebee-grafana
prometheus.remote_write "bumblebee_grafana" {
  endpoint {
    url = "https://bumblebee.example.ts.net:9090/api/v1/write"
  }
}

